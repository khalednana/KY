{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/quality/layout,_N_T_/[lang]/quality/page,_N_T_/ar/quality"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/quality/__PAGE__",
    "/$d$lang/quality",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}